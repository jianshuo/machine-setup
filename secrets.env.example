# secrets.env — 真实密钥放这里。安装脚本会拷成 ~/.config/secrets.env
# 千万不要把填好真实值的版本提交到 git！本 .example 只放占位符。
#
# 用法：
#   cp secrets.env.example ~/.config/secrets.env
#   然后从你旧机器的 ~/.zshrc / ~/code/.env 里把真实值填进来。

# ===== 火山引擎 / 豆包语音（TTS / ASR）=====
export VOLC_APPID="CHANGE_ME"
export MODEL_SPEECH_API_KEY="CHANGE_ME"

# ===== X / Twitter（xurl 发推）=====
export X_ACCESS_TOKEN="CHANGE_ME"

# ===== 其它在 ~/code/.env 里的密钥 =====
# ~/code/.env 也会被 .zshrc 自动 source。把旧机器那份 .env 整体拷过来即可，
# 不要提交到公开 repo。
