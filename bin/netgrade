#!/bin/bash
# netgrade — 一键网络体检与评级（macOS）
# 分两段诊断：WiFi 段（Mac→路由器）和出口段（路由器→Internet），各自评级并指出瓶颈。
#
# 用法:
#   netgrade          完整体检（含带宽测试，约 40 秒）
#   netgrade --fast   快速体检（跳过带宽测试，约 10 秒）

set -u

FAST=0
[[ "${1:-}" == "--fast" ]] && FAST=1

B=$'\033[1m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; DIM=$'\033[2m'; N=$'\033[0m'

# 数值→等级：4=A 3=B 2=C 1=D
letter() { case $1 in 4) echo A;; 3) echo B;; 2) echo C;; *) echo D;; esac; }
mark()   { case $1 in 4) echo "${G}✅${N}";; 3) echo "${G}🙂${N}";; 2) echo "${Y}⚠️ ${N}";; *) echo "${R}❌${N}";; esac; }
color_letter() { case $1 in 4|3) echo "${G}$(letter $1)${N}";; 2) echo "${Y}C${N}";; *) echo "${R}D${N}";; esac; }
# ge <a> <b>: a >= b (浮点)
ge() { awk -v a="$1" -v b="$2" 'BEGIN{exit !(a+0>=b+0)}'; }

echo "${B}📋 netgrade 网络体检${N} $(date '+%Y-%m-%d %H:%M')"
echo

# ── WiFi 段 ────────────────────────────────────────────────
GW=$(route -n get default 2>/dev/null | awk '/gateway/{print $2}')
IFACE=$(route -n get default 2>/dev/null | awk '/interface/{print $2}')
if [[ -z "$GW" ]]; then
  echo "${R}❌ 没有默认网关——当前没有可用网络连接。${N}"; exit 1
fi

# 先 ping 再采样链路：空闲时 macOS 会把 WiFi 协商速率降档省电，需要流量唤醒才测得准
echo "${DIM}[1/3] ping 路由器 ($GW)…${N}"
GWPING=$(ping -c 10 -i 0.2 "$GW" 2>/dev/null | awk -F'[/ ]' '/round-trip/{print $8}')

echo "${DIM}[2/3] 检测 WiFi 链路…${N}"
ping -c 8 -i 0.5 "$GW" >/dev/null 2>&1 &   # 采样期间持续给一点流量，防止速率回落
AIRINFO=$(system_profiler SPAirPortDataType 2>/dev/null | sed -n '/Current Network Information/,/Other Local/p')
wait
CHANNEL=$(echo "$AIRINFO" | awk -F': ' '/Channel:/{print $2; exit}')
SIGNAL=$(echo "$AIRINFO"  | awk '/Signal \/ Noise/{print $4; exit}')
TXRATE=$(echo "$AIRINFO"  | awk -F': ' '/Transmit Rate/{print $2; exit}')

WIFI=1   # 是否 WiFi 连接
[[ -z "$CHANNEL" ]] && WIFI=0

# WiFi 各项评级
if [[ $WIFI == 1 ]]; then
  BAND="2.4GHz"; [[ "$CHANNEL" == *5GHz* ]] && BAND="5GHz"; [[ "$CHANNEL" == *6GHz* ]] && BAND="6GHz"

  if   ge "$SIGNAL" -60; then G_SIG=4
  elif ge "$SIGNAL" -67; then G_SIG=3
  elif ge "$SIGNAL" -75; then G_SIG=2
  else G_SIG=1; fi

  if   ge "$TXRATE" 400; then G_TX=4
  elif ge "$TXRATE" 200; then G_TX=3
  elif ge "$TXRATE" 100; then G_TX=2
  else G_TX=1; fi
fi

if   [[ -z "${GWPING:-}" ]]; then G_GWP=1; GWPING="超时"
elif ge 10 "$GWPING"; then G_GWP=4
elif ge 25 "$GWPING"; then G_GWP=3
elif ge 60 "$GWPING"; then G_GWP=2
else G_GWP=1; fi

if [[ $WIFI == 1 ]]; then
  G_WIFI=$G_SIG
  [[ $G_TX  -lt $G_WIFI ]] && G_WIFI=$G_TX
  [[ $G_GWP -lt $G_WIFI ]] && G_WIFI=$G_GWP
  [[ "$BAND" == "2.4GHz" && $G_WIFI -gt 2 ]] && G_WIFI=2   # 2.4GHz 封顶 C
else
  G_WIFI=$G_GWP   # 有线连接只看网关延迟
fi

# ── 出口段 ────────────────────────────────────────────────
EXTPING=$(ping -c 10 -i 0.3 223.5.5.5 2>/dev/null | awk -F'[/ ]' '/round-trip/{print $8}')

DL=""; UL=""; RPM=""; IDLE=""
if [[ $FAST == 0 ]]; then
  echo "${DIM}[3/3] 测试带宽与负载响应（约 20 秒）…${N}"
  NQ=$(networkQuality -v 2>/dev/null)
  DL=$(echo "$NQ"   | awk '/Downlink capacity/{v=$3} END{print v}')
  UL=$(echo "$NQ"   | awk '/Uplink capacity/{v=$3} END{print v}')
  IDLE=$(echo "$NQ" | awk '/Idle Latency/{v=$3} END{print v}')
  RPM=$(echo "$NQ"  | awk -F'|' '/Responsiveness:/{v=$2} END{gsub(/[^0-9]/,"",v); print v}')
else
  echo "${DIM}[3/3] 快速模式，跳过带宽测试${N}"
fi

# 出口段评级
SCORES=();
if [[ -n "$DL" ]]; then
  if   ge "$DL" 80; then SCORES+=(4)
  elif ge "$DL" 40; then SCORES+=(3)
  elif ge "$DL" 15; then SCORES+=(2)
  else SCORES+=(1); fi
fi
if [[ -n "$IDLE" ]]; then
  if   ge 50  "$IDLE"; then SCORES+=(4)
  elif ge 100 "$IDLE"; then SCORES+=(3)
  elif ge 200 "$IDLE"; then SCORES+=(2)
  else SCORES+=(1); fi
fi
if [[ -n "$RPM" ]]; then
  if   ge "$RPM" 800; then SCORES+=(4)
  elif ge "$RPM" 300; then SCORES+=(3)
  elif ge "$RPM" 100; then SCORES+=(2)
  else SCORES+=(1); fi
fi
if [[ ${#SCORES[@]} -eq 0 ]]; then   # fast 模式：只看外网 ping
  if   [[ -z "${EXTPING:-}" ]]; then SCORES+=(1); EXTPING="超时"
  elif ge 60  "$EXTPING"; then SCORES+=(4)
  elif ge 120 "$EXTPING"; then SCORES+=(3)
  elif ge 250 "$EXTPING"; then SCORES+=(2)
  else SCORES+=(1); fi
fi
SUM=0; for s in "${SCORES[@]}"; do SUM=$((SUM+s)); done
G_WAN=$(( (SUM + ${#SCORES[@]}/2) / ${#SCORES[@]} ))

# ── 输出报告 ──────────────────────────────────────────────
echo
if [[ $WIFI == 1 ]]; then
  echo "${B}📡 WiFi 段（Mac → 路由器）${N}"
  printf "   %-14s %-22s %b\n" "频段/信道"  "$CHANNEL"        "$([[ "$BAND" == "2.4GHz" ]] && echo "${Y}⚠️  建议切 5GHz${N}" || echo "${G}✅${N}")"
  printf "   %-14s %-22s %b\n" "信号"       "${SIGNAL} dBm"   "$(mark $G_SIG)"
  printf "   %-14s %-22s %b\n" "协商速率"    "${TXRATE} Mbps"  "$(mark $G_TX)"
  printf "   %-14s %-22s %b\n" "路由器延迟"  "${GWPING} ms"    "$(mark $G_GWP)"
else
  echo "${B}🔌 本地段（有线 → 路由器）${N}"
  printf "   %-14s %-22s %b\n" "路由器延迟"  "${GWPING} ms"    "$(mark $G_GWP)"
fi
echo "   ${B}→ 评级: $(color_letter $G_WIFI)${N}"
echo

echo "${B}🌐 出口段（路由器 → Internet）${N}"
[[ -n "$DL" ]]   && printf "   %-14s %s\n" "下行/上行"  "${DL} / ${UL} Mbps"
[[ -n "$IDLE" ]] && printf "   %-14s %s\n" "空闲延迟"   "${IDLE} ms"
[[ -n "$RPM" ]]  && printf "   %-14s %-22s %b\n" "负载响应" "${RPM} RPM" "$([[ -n "$RPM" ]] && ge 300 "$RPM" 2>/dev/null && echo "${Y}⚠️  有 bufferbloat${N}" || echo "${G}✅${N}")"
[[ -n "${EXTPING:-}" ]] && printf "   %-14s %s\n" "国内延迟" "${EXTPING} ms (223.5.5.5)"
echo "   ${B}→ 评级: $(color_letter $G_WAN)${N}"
echo

# ── 综合结论 ──────────────────────────────────────────────
G_ALL=$G_WIFI; [[ $G_WAN -lt $G_ALL ]] && G_ALL=$G_WAN
echo "${B}综合评级: $(color_letter $G_ALL)${N}"
if   [[ $G_WIFI -lt $G_WAN ]]; then
  echo "瓶颈在 ${B}WiFi 段${N}——先检查频段（务必 5GHz）、信号强度，再考虑挪路由器/加 Mesh。"
elif [[ $G_WAN -lt $G_WIFI ]]; then
  echo "瓶颈在 ${B}出口段${N}——是宽带线路本身的水平，家里设备怎么调都没用。"
else
  echo "两段水平相当，没有明显短板。"
fi
