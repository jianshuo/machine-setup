# ~/.zshrc — 由 machine-setup 部署（安装脚本会把本文件拷成 ~/.zshrc）。
# 通用配置（PATH / 代理 / alias / 密钥引用）都在 repo 的 shellrc 里，bash 也能用。

[ -f "$HOME/code/machine-setup/shellrc" ] && source "$HOME/code/machine-setup/shellrc"

# ===== 以下是 zsh 专属，不要挪进 shellrc =====

# ccline — 在 shell 里打一句话直接得到回答
[ -f "$HOME/.config/ccline/ccline.zsh" ] && source "$HOME/.config/ccline/ccline.zsh"

# Prompt: hostname + 当前文件夹名 (%m = short hostname, %1~ = last folder, %# = %/#)
PROMPT='%F{green}%m%f:%F{blue}%1~%f %# '

# zsh completion（fpath 改完后 compinit 保持在最后、只跑一次）
[ -d "$HOME/.grok/completions/zsh" ] && fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
