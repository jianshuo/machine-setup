# shellrc — 通用 shell 配置，zsh / bash 都能 source。由 ~/.zshrc 引用：
#   [ -f ~/code/machine-setup/shellrc ] && source ~/code/machine-setup/shellrc
# 规则：本文件只放 POSIX 兼容、可公开的内容（export / alias / PATH / source）。
# 密钥在 ~/code/.env（不进 git），shell 专属的（prompt / 补全）留在 ~/.zshrc。

# ===== PATH =====
export PATH="$HOME/.local/bin:$PATH"
export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
export PATH="$HOME/.claude/bin:$PATH"
export PATH="$HOME/.grok/bin:$PATH"

# ===== nvm =====
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# source $HOME/code/machine-setup/proxy.sh

# ===== 非密钥开关 =====
export X_AUTO_PUBLISH=true

# ===== 密钥（真实值统一在 ~/code/.env，不进 git）=====
[ -f "$HOME/code/.env" ] && . "$HOME/code/.env"

# ===== git 身份 =====
export GIT_USER_NAME="Jianshuo Wang"
export GIT_USER_EMAIL="jianshuo@hotmail.com"

# ===== 通用别名 =====
alias cc="cd ~/code && claude agents"

# cclaude → 通过本地 ccglass 跑 claude（看发给模型的内容）
alias cclaude='node ~/code/ccglass/bin/ccglass.js claude'

alias ie="open -a Safari"

